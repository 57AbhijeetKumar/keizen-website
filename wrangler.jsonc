{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "keizen-website",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "keizen-website"
    }
  ],
  // next/image optimisation via Cloudflare Images (free tier: 5,000 unique
  // transformations a month; past that, already-cached sizes keep working).
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}
