{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "keizen-website",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "keizen-website"
    }
  ],
  // next/image optimisation via Cloudflare Images (free tier: 5,000 unique
  // transformations a month; past that, already-cached sizes keep working).
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  },
  // Serve on keizen-website.<account>.workers.dev, with per-branch preview URLs.
  "workers_dev": true,
  "preview_urls": true,
  // Non-secret config lives here. OPENAI_API_KEY and LEADS_SHEET_WEBHOOK_URL
  // are Secrets set in the dashboard — deploys never touch secrets.
  "vars": {
    "BROCHURE_DRIVE_FILE_ID": "1ES7KZ63XfOhalIrcKloHADhSp8i7f-X0"
  },
  // Don't wipe plain-text variables added in the dashboard on each deploy.
  "keep_vars": true
}
